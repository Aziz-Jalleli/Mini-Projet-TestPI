<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Cross-browser suite: the same 20 tests on Chrome, Firefox and Edge, in parallel. -->
<suite name="PI.TN - Cross-browser" verbose="1" parallel="tests" thread-count="3">
  <listeners>
    <listener class-name="tn.pi.qa.report.HtmlReporter"/>
  </listeners>

  <test name="Chrome">
    <parameter name="browser" value="chrome"/>
    <classes>
      <class name="tn.pi.qa.tests.PiSeleniumTests"/>
    </classes>
  </test>

  <test name="Firefox">
    <parameter name="browser" value="firefox"/>
    <classes>
      <class name="tn.pi.qa.tests.PiSeleniumTests"/>
    </classes>
  </test>

  <test name="Edge">
    <parameter name="browser" value="edge"/>
    <classes>
      <class name="tn.pi.qa.tests.PiSeleniumTests"/>
    </classes>
  </test>
</suite>
